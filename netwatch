    def on_hotspot(self, hs):
        self.hotspot = hs
        if hs is None or self.paused:
            return
        dt = self.last_dt
        devices = hs.get("devices", [])
        on = [d for d in devices if d["connected"]]
        self.hs_page.set_badge_number(len(on))
        if not hs["active"] and not devices:
            self.hs_stack.set_visible_child_name("off")
            return
        self.hs_stack.set_visible_child_name("on")
        if hs["active"]:
            first = hs["ifaces"][0]
            self.hs_name.set_text(first["ssid"] or "Shared connection")
            bits = []
            for i in hs["ifaces"]:
                band = ""
                if i.get("freq"):
                    band = " · %s GHz" % ("2.4" if i["freq"] < 3000 else "5" if i["freq"] < 5925 else "6")
                bits.append(i["name"] + band)
            bits.append("%d device%s connected" % (len(on), "" if len(on) == 1 else "s"))
            self.hs_info.set_text("  ·  ".join(bits))
        else:
            self.hs_name.set_text("Hotspot is off")
            self.hs_info.set_text("Today's usage and the limits you set are kept for when it is back on.")
        self.hs_stats[0].set_text(fmt_rate(sum(d["now_down"] for d in devices) / dt, self.bits))
        self.hs_stats[1].set_text(fmt_rate(sum(d["now_up"] for d in devices) / dt, self.bits))
        self.hs_stats[2].set_text(fmt_bytes(sum(d["today_up"] + d["today_down"] for d in devices)))
        if not hs.get("controls"):
            self.hs_notice.set_text("Blocking and limits are not available: %s" % (hs.get("error") or "unknown reason"))
        self.hs_notice.set_visible(not hs.get("controls"))

        seen = set()
        for d in devices:
            seen.add(d["mac"])
            row = self.dev_rows.get(d["mac"])
            if row is None:
                row = self.dev_rows[d["mac"]] = DeviceRow(self, d["mac"])
                self.dev_list.append(row)
            row.update(d, dt, self.bits)
        for mac in [m for m in self.dev_rows if m not in seen]:
            self.dev_list.remove(self.dev_rows.pop(mac))
        if not self.dev_hovering:
            self.dev_list.invalidate_sort()

    @staticmethod
    def _sort_devices(a, b):
        da, db = a.d, b.d
        ka = (not da.get("connected"), -(da.get("now_down", 0) + da.get("now_up", 0)),
              -(da.get("today_up", 0) + da.get("today_down", 0)), device_name(da).lower()) if da else (True,)
        kb = (not db.get("connected"), -(db.get("now_down", 0) + db.get("now_up", 0)),
              -(db.get("today_up", 0) + db.get("today_down", 0)), device_name(db).lower()) if db else (True,)
        return (ka > kb) - (ka < kb)

    def send(self, command, callback):
        if self.client is None or not hasattr(self.client, "send"):
            callback({"ok": False, "error": "monitoring is not running"})
            return
        self.client.send(command, callback)

