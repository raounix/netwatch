    def __init__(self, on_message):
        self.on_message = on_message
        self.t = 0
        self.rng = random.Random(7)
        self.devices = {}
        for mac, spec in self.DEVICES.items():
            rules = dict(blocked=False, up=None, down=None, quota=None)
            rules.update(spec.get("rules", {}))
            used = spec.get("used", 0)
            self.devices[mac] = dict(mac=mac, hostname=spec["hostname"], ip=spec["ip"], vendor=spec["vendor"],
                                     private_mac=spec["private_mac"], name=spec.get("name"),
                                     connected=spec.get("connected", True), signal=spec.get("signal"),
                                     connected_for=spec.get("connected_for"), link_mbps=spec.get("link_mbps"),
                                     inactive_ms=50, iface="wlo1", ssid="raounix2",
                                     last_seen=time.time() - (7200 if not spec.get("connected", True) else 0),
                                     today_up=used // 8, today_down=used - used // 8, rules=rules,
                                     rate=spec.get("rate", (0, 0)))
        self.sources = [GLib.idle_add(self._hello), GLib.timeout_add(1000, self._tick)]

    def _hello(self):
        self.sources.pop(0)                  # a one-shot source is gone once it returns False
        self.on_message({"type": "hello", "protocol": PROTOCOL, "version": "demo", "interval": 1.0,
                         "ifaces": [{"name": "enp45s0", "kind": "physical", "uplink": True}]})
        return False

    def _tick(self):
        self.t += 1
        r, t = self.rng, self.t
        load = {
            "app:google-chrome": (2.6e6 + 1.2e6 * abs((t % 30) - 15) / 15 + r.random() * 4e5, 4.0e4),
            "svc:snapd": ((7.5e6 if 20 <= t % 60 < 34 else 0) + r.random() * 2e3, 6e3 if 20 <= t % 60 < 34 else 0),
            "proc:1000:npm": ((1.4e6 * r.random() if t % 45 < 12 else 0), 2e4 if t % 45 < 12 else 0),
            "app:termius-app_termius-app": (3e3 + r.random() * 2e3, 2.5e3 + r.random() * 1.5e3),
            "app:jetbrains-webstorm": (r.random() * 6e4 if t % 9 == 0 else 0, r.random() * 2e4 if t % 9 == 0 else 0),
            "app:telegram-desktop_telegram-desktop": (8e3 + r.random() * 6e4, 1.2e5 if t % 20 < 3 else 4e3),
            "svc:docker": ((3.1e6 if 5 <= t % 80 < 25 else 0), 1.5e4 if 5 <= t % 80 < 25 else 0),
            "svc:systemd-resolved": (r.random() * 2e3, r.random() * 1e3),
        }
        procs, rx, tx = [], 0, 0
        for app, pid, comm, cmd, via in self.PROCS:
            a, b = (int(v) for v in load[app])
            if a or b:
                procs.append({"pid": pid, "start": 1000 + pid, "comm": comm, "cmd": cmd, "user": "raounix",
                              "app": app, "via": via, "rx": a, "tx": b})
                rx, tx = rx + a, tx + b
        ua, ub = int(r.random() * 6e3), int(r.random() * 3e3)
        procs.append({"pid": 0, "start": 0, "comm": "", "cmd": "", "user": "", "app": "other:unattributed",
                      "via": None, "rx": ua, "tx": ub})
        devices, hd, hu = [], 0, 0
        for d in self.devices.values():
            r_ = d["rules"]
            down, up = d["rate"]
            if not d["connected"] or r_["blocked"]:
                down = up = 0
            if r_["down"]:
                down = min(down, r_["down"])
            if r_["up"]:
                up = min(up, r_["up"])
            if r_["quota"] and d["today_up"] + d["today_down"] >= r_["quota"]:
                down = up = 0
            down, up = int(down * (0.7 + 0.6 * r.random())), int(up * (0.7 + 0.6 * r.random()))
            if r_["down"]:
                down = min(down, r_["down"])
            d["today_down"] += down
            d["today_up"] += up
            if d["connected"] and d["connected_for"]:
                d["connected_for"] += 1
            hd, hu = hd + down, hu + up
            devices.append(dict({k: v for k, v in d.items() if k != "rate"}, now_down=down, now_up=up,
                                quota_used=(d["today_up"] + d["today_down"]) if r_["quota"] else None,
                                rules=dict(r_)))
        if hd or hu:
            procs.append({"pid": 0, "start": 0, "comm": "", "cmd": "", "user": "", "app": "other:hotspot",
                          "via": None, "rx": hd, "tx": hu})
            rx, tx = rx + hd, tx + hu
        self.on_message({"type": "tick", "seq": t, "dt": 1.0, "rx": rx + ua, "tx": tx + ub, "drops": 0,
                         "ifaces": [{"name": "enp45s0", "kind": "physical", "uplink": True,
                                     "rx": rx + ua, "tx": tx + ub}],
                         "procs": procs, "apps": {p["app"]: self.APPS[p["app"]] for p in procs},
                         "hotspot": {"active": True, "controls": True, "error": None,
                                     "ifaces": [{"name": "wlo1", "ssid": "raounix2", "freq": 2412, "wifi": True}],
                                     "devices": devices}})
        return True

    def send(self, command, callback):
        d = self.devices.get(command.get("mac"))
        ack = {"type": "ack", "ok": d is not None, "error": None if d else "unknown device"}
        if d is not None:
            if command["cmd"] == "set_device":
                d["rules"] = {k: command.get(k) for k in ("blocked", "up", "down", "quota")}
                d["name"] = command.get("name")
            elif command["cmd"] == "reset_today":
                d["today_up"] = d["today_down"] = 0
            elif command["cmd"] == "disconnect":
                d["connected"] = False
                d["last_seen"] = time.time()
        GLib.timeout_add(150, lambda: (callback(ack), False)[1])

    def stop(self):
        for source in self.sources:
            GLib.source_remove(source)
        self.sources = []


