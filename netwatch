# ── formatting ──────────────────────────────────────────────────────────────
def _scaled(v, units):
    i = 0
    while v >= 999.5 and i < len(units) - 1:
        v /= 1000.0
        i += 1
    if i == 0:
        return "%d %s" % (round(v), units[0])
    return ("%.1f %s" if v < 99.95 else "%.0f %s") % (v, units[i])


def fmt_rate(bytes_per_s, bits=False):
    if bits:
        return _scaled(bytes_per_s * 8, ("bit/s", "kbit/s", "Mbit/s", "Gbit/s"))
    return _scaled(bytes_per_s, ("B/s", "kB/s", "MB/s", "GB/s"))


def fmt_bytes(n):
    return _scaled(n, ("B", "kB", "MB", "GB", "TB"))


def fmt_duration(seconds):
    seconds = int(seconds or 0)
    if seconds < 60:
        return "%d s" % seconds
    if seconds < 3600:
        return "%d min" % (seconds // 60)
    if seconds < 86400:
        return "%d h %d min" % (seconds // 3600, seconds % 3600 // 60)
    return "%d d %d h" % (seconds // 86400, seconds % 86400 // 3600)


def signal_words(dbm):
    if dbm is None:
        return None
    word = "excellent" if dbm >= -50 else "good" if dbm >= -60 else "fair" if dbm >= -70 else "weak"
    return "%d dBm, %s" % (dbm, word)


def device_name(d):
    if d.get("name"):
        return d["name"]
    if d.get("hostname"):
        return d["hostname"]
    if d.get("vendor"):
        return "%s device" % d["vendor"].split(",")[0].split(" ")[0]
    return "Unknown device"


def quota_bar(**props):
    """A LevelBar for a daily limit: GTK's default offsets turn it green as it
    fills (fuller = better, like a battery) — here fuller is worse."""
    bar = Gtk.LevelBar(min_value=0, max_value=1, **props)
    for name in (Gtk.LEVEL_BAR_OFFSET_LOW, Gtk.LEVEL_BAR_OFFSET_HIGH, Gtk.LEVEL_BAR_OFFSET_FULL):
        bar.remove_offset_value(name)
    bar.add_css_class("nw-quota")
    return bar


def set_quota_bar(bar, fraction):
    bar.set_value(max(0.0, min(1.0, fraction)))
    for css, on in (("nw-warn", 0.8 <= fraction < 1.0), ("nw-full", fraction >= 1.0)):
        if on:
            bar.add_css_class(css)
        else:
            bar.remove_css_class(css)


def device_icon(d):
    text = " ".join(filter(None, (d.get("name"), d.get("hostname"), d.get("vendor")))).lower()
    return "phone-symbolic" if any(h in text for h in PHONE_HINTS) else "computer-symbolic"


def rgba(hexcolor, alpha=1.0):
    c = Gdk.RGBA()
    c.parse(hexcolor)
    c.alpha = alpha
    return c


# ── desktop names and icons ─────────────────────────────────────────────────
class AppDirectory:
    """Application ids → (display name, icon), from the installed .desktop files."""

    def __init__(self):
        self._cache = {}
        self._by_exec = None

    @staticmethod
    def _desktop(desktop_id):
        try:
            return DesktopAppInfo.new(desktop_id + ".desktop")
        except TypeError:        # constructor returned NULL: no such entry
            return None

    def _exec_index(self):
        if self._by_exec is None:
            self._by_exec = {}
            for info in Gio.AppInfo.get_all():
                exe = os.path.basename(info.get_executable() or "")
                exe = exe[:-3] if exe.endswith(".sh") else exe
                if exe and exe not in NOT_AN_APP:
                    self._by_exec.setdefault(exe, info)
        return self._by_exec

    def lookup(self, app_id, program):
        key = (app_id, program)
        if key not in self._cache:
            info = None
            for cand in filter(None, (app_id, app_id.lower() if app_id else None)):
                info = self._desktop(cand)
                if info:
                    break
            if info is None and program and program not in NOT_AN_APP:
                info = self._desktop(program) or self._exec_index().get(program)
            self._cache[key] = (info.get_display_name(), info.get_icon()) if info else (None, None)
        return self._cache[key]


# ── the model ───────────────────────────────────────────────────────────────
class Entry:
    """One row: an application, or a single process when grouping by process."""

    def __init__(self, key, kind, label, app_id=None, desc=None):
        self.key, self.kind, self.label, self.app_id, self.desc = key, kind, label, app_id, desc
        self.program = label
        self.app_key = key       # for process rows: the application they belong to
        self.via = None
        self.cmd = ""
        self.pid = 0
        self.rx = self.tx = 0.0              # bytes per second, last interval
        self.rx_total = self.tx_total = 0
        self.last_active = 0.0
        self.procs = {}                      # pid → dict (application rows only)
        self.display = label
        self.icon = None
        self.row = None

    def add(self, rx, tx, dt, now):
        self.rx += rx / dt
        self.tx += tx / dt
        self.rx_total += rx
        self.tx_total += tx
        if rx or tx:
            self.last_active = now

    def idle(self, now):
        return now - self.last_active > IDLE_AFTER


# ── widgets ─────────────────────────────────────────────────────────────────
class Sparkline(Gtk.Widget):
    """The last HISTORY seconds as a filled line, drawn with GSK paths (no cairo)."""

    def __init__(self, which):
        super().__init__()
        self.which = which
        self.values = []
        self.set_size_request(-1, 58)
        self.set_hexpand(True)

    def set_values(self, values):
        self.values = list(values)
        self.queue_draw()

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        if w <= 2 or h <= 2:
            return
        dark = Adw.StyleManager.get_default().get_dark()
        color = PALETTE[self.which][1 if dark else 0]
        base = Gsk.PathBuilder.new()
        base.move_to(0, h - 0.5)
        base.line_to(w, h - 0.5)
        snapshot.append_stroke(base.to_path(), Gsk.Stroke.new(1), rgba("#ffffff" if dark else "#000000", 0.12))
        vals = self.values[-HISTORY:]
        if len(vals) < 2:
            return
        top = max(max(vals) * 1.15, 1.0)
        step = w / (HISTORY - 1)
        x0 = w - (len(vals) - 1) * step
        pts = [(x0 + i * step, (h - 3) - (h - 6) * (v / top)) for i, v in enumerate(vals)]
        fill = Gsk.PathBuilder.new()
        fill.move_to(pts[0][0], h)
        for x, y in pts:
            fill.line_to(x, y)
        fill.line_to(pts[-1][0], h)
        fill.close()
        snapshot.append_fill(fill.to_path(), Gsk.FillRule.WINDING, rgba(color, 0.18))
        line = Gsk.PathBuilder.new()
        line.move_to(*pts[0])
        for x, y in pts[1:]:
            line.line_to(x, y)
        stroke = Gsk.Stroke.new(2.0)
        stroke.set_line_join(Gsk.LineJoin.ROUND)
        stroke.set_line_cap(Gsk.LineCap.ROUND)
        snapshot.append_stroke(line.to_path(), stroke, rgba(color))


