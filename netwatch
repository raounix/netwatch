        e = self.entry
        bits = window.bits
        self.name.set_text(e.display)
        self.sub.set_text(window.subtitle(e))
        if e.icon is not None:
            self.icon.set_from_gicon(e.icon)
        else:
            self.icon.set_from_icon_name(KIND_ICONS.get(e.kind, KIND_ICONS["app"]))
        idle = e.idle(now)
        if idle:
            self.add_css_class("nw-idle")
        else:
            self.remove_css_class("nw-idle")
        self.bar.set_fraction(min(1.0, share))
        self.bar.set_visible(share > 0.001)
        quiet = e.rx < 0.5 and e.tx < 0.5
        self.cells[0].set_text("—" if quiet else fmt_rate(e.rx, bits))
        self.cells[1].set_text("—" if quiet else fmt_rate(e.tx, bits))
        self.cells[2].set_text(fmt_bytes(e.rx_total))
        self.cells[3].set_text(fmt_bytes(e.tx_total))
        tip = [e.display]
        if e.desc:
            tip.append(e.desc)
        if e.cmd:
            tip.append(e.cmd)
        self.set_tooltip_text("\n".join(tip))


class DeviceRow(Gtk.ListBoxRow):
    """One device on the hotspot."""

    def __init__(self, window, mac):
        super().__init__(activatable=True)
        self.mac = mac
        self.d = {}
        box = Gtk.Box(spacing=12, margin_top=7, margin_bottom=7, margin_start=12, margin_end=12)
        self.icon = Gtk.Image(pixel_size=32, valign=Gtk.Align.CENTER)
        self.icon.add_css_class("nw-fade")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True, valign=Gtk.Align.CENTER)
        top = Gtk.Box(spacing=8)
        self.name = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.name.add_css_class("heading")
        self.name.add_css_class("nw-fade")
        self.badges = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        top.append(self.name)
        top.append(self.badges)
        self.sub = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.sub.add_css_class("caption")
        self.sub.add_css_class("dim-label")
        self.quota = quota_bar(margin_top=2)
        for w in (top, self.sub, self.quota):
            text.append(w)
        box.append(self.icon)
        box.append(text)
        self.cells = []
        for i, css in enumerate(("nw-down", "nw-up", "dim-label")):
            cell = Gtk.Label(xalign=1)
            cell.add_css_class("numeric")
            cell.add_css_class("nw-fade")
            cell.add_css_class(css)
            window.dev_groups[i].add_widget(cell)
            box.append(cell)
            self.cells.append(cell)
        self.set_child(box)

    def update(self, d, dt, bits):
        self.d = d
        self.name.set_text(device_name(d))
        self.icon.set_from_icon_name(device_icon(d))
        parts = [d["ip"] or "no address yet"]
        parts.append(d["vendor"] or ("private address" if d["private_mac"] else "unknown maker"))
        if d["connected"]:
            if d.get("signal") is not None:
                parts.append(signal_words(d["signal"]))
            if d.get("connected_for"):
                parts.append("connected %s" % fmt_duration(d["connected_for"]))
        else:
            parts.append("not connected" + (" · last seen %s" % time.strftime("%H:%M", time.localtime(d["last_seen"]))
                                            if d.get("last_seen") else ""))
        self.sub.set_text("  ·  ".join(parts))
        if d["connected"]:
            self.remove_css_class("nw-idle")
        else:
            self.add_css_class("nw-idle")

        child = self.badges.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.badges.remove(child)
            child = nxt
        r = d["rules"]
        badges = []
        if r["blocked"]:
            badges.append(("No internet", "error"))
        if r["down"]:
            badges.append(("↓ " + fmt_rate(r["down"]), "accent"))
        if r["up"]:
            badges.append(("↑ " + fmt_rate(r["up"]), "accent"))
        if r["quota"]:
            used = d.get("quota_used") or 0
            badges.append(("Daily limit reached" if used >= r["quota"] else "Daily %s" % fmt_bytes(r["quota"]),
                           "error" if used >= r["quota"] else "warning"))
        for text, css in badges:
            label = Gtk.Label(label=text)
            label.add_css_class("nw-badge")
            label.add_css_class(css)
            self.badges.append(label)
        self.quota.set_visible(bool(r["quota"]))
        if r["quota"]:
            set_quota_bar(self.quota, (d.get("quota_used") or 0) / r["quota"])
        quiet = not d["now_down"] and not d["now_up"]
        self.cells[0].set_text("—" if quiet else fmt_rate(d["now_down"] / dt, bits))
        self.cells[1].set_text("—" if quiet else fmt_rate(d["now_up"] / dt, bits))
        self.cells[2].set_text(fmt_bytes(d["today_up"] + d["today_down"]))


# ── the helper process ──────────────────────────────────────────────────────
class HelperClient:
    """Runs the helper, hands each JSON line to on_message, sends commands to
    its stdin, and calls on_exit once the process has exited AND both of its
    output pipes are drained — so a last {"type": "error"} line is never lost.
    Nothing a report contains can stop the reading: a bad line is skipped and
    an exception while handling one is printed, not allowed to end the loop
    (a stalled reader would leave the helper blocked on a full pipe)."""

    def __init__(self, argv, on_message, on_exit):
        self.on_message, self.on_exit = on_message, on_exit
        self.proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDIN_PIPE |
                                       Gio.SubprocessFlags.STDOUT_PIPE |
                                       Gio.SubprocessFlags.STDERR_PIPE)
        # Raw chunks, split into lines here: DataInputStream.read_line_finish()
        # returns b"" both for an empty line and for end-of-stream, so a reader
        # built on it can never tell that the helper has gone.
        self.out = self.proc.get_stdout_pipe()
        self.buf = b""
        self.err = self.proc.get_stderr_pipe()
        self.stderr = b""
        self.pending = 3                     # stdout EOF, stderr EOF, process exit
        self.detached = False                # stopped on purpose: report nothing more
        self.status = None
        self.last_error = None
        self.next_id = 0
        self.waiting = {}                    # command id → callback(ack)
        self.out.read_bytes_async(1 << 16, GLib.PRIORITY_DEFAULT, None, self._chunk)
        self.err.read_bytes_async(4096, GLib.PRIORITY_DEFAULT, None, self._stderr)
        self.proc.wait_async(None, self._exited)

    def _done(self):
        self.pending -= 1
        if self.pending == 0 and not self.detached:
            self.on_exit(self.status, self.stderr.decode("utf-8", "replace").strip(), self.last_error)

    def _chunk(self, stream, result):
        try:
            data = stream.read_bytes_finish(result).get_data()
        except GLib.Error:
            data = b""
        if not data:                         # size 0 is end-of-stream, unambiguously
            self._done()
            return
        try:
            self.buf += data
            *lines, self.buf = self.buf.split(b"\n")
            if len(self.buf) > 8 << 20:      # no report is this long: drop it
                self.buf = b""
            for line in lines:
                if line.strip() and not self.detached:
                    try:
                        self._dispatch(line)
                    except Exception:        # noqa: BLE001 — one bad report must not end the reading
                        import traceback
                        traceback.print_exc()
        finally:
            self.out.read_bytes_async(1 << 16, GLib.PRIORITY_DEFAULT, None, self._chunk)

    def _dispatch(self, line):
        try:
            msg = json.loads(bytes(line).decode("utf-8", "replace"))
        except ValueError:
            return
        if not isinstance(msg, dict):
            return
        if msg.get("type") == "ack":
            callback = self.waiting.pop(msg.get("id"), None)
            if callback is not None:
                callback(msg)
            return
        if msg.get("type") == "error":
            self.last_error = str(msg.get("message", ""))
        self.on_message(msg)

    def send(self, command, callback):
        """One command to the helper; callback(ack) when it answers."""
        self.next_id += 1
        command = dict(command, id=self.next_id)
        self.waiting[self.next_id] = callback
        try:
            self.proc.get_stdin_pipe().write_all((json.dumps(command) + "\n").encode(), None)
        except GLib.Error as e:
            self.waiting.pop(self.next_id, None)
            callback({"type": "ack", "ok": False, "error": e.message})

    def _stderr(self, stream, result):
        try:
            data = stream.read_bytes_finish(result).get_data()
        except GLib.Error:
            data = b""
        if not data:
            self._done()
            return
        self.stderr = (self.stderr + data)[-8192:]
        self.err.read_bytes_async(4096, GLib.PRIORITY_DEFAULT, None, self._stderr)

    def _exited(self, proc, result):
        try:
            proc.wait_finish(result)
        except GLib.Error:
            pass
        self.status = proc.get_exit_status() if proc.get_if_exited() else -1
        for callback in self.waiting.values():
            callback({"type": "ack", "ok": False, "error": "the helper stopped"})
        self.waiting = {}
        self._done()

    def stop(self):
        """Close the helper's stdin — it exits on EOF. Its output is still read
        to the end (so it never blocks on a full pipe), but nothing more is reported."""
        self.detached = True
        self.waiting = {}
        pipe = self.proc.get_stdin_pipe()
        if pipe is not None and not pipe.is_closed():
            try:
                pipe.close(None)
            except GLib.Error:
                pass


