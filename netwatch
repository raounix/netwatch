    def _show(self, page):
        self.stack.set_visible_child_name(page)
        live = page == "main"
        for w in self.header_controls:
            w.set_sensitive(live)
        self.header.set_title_widget(self.switcher if live else self.title)
        if not live:                     # no capture now: no capture warnings, no interface names
            self.banner.set_revealed(False)
            self.last_drop_at = -1e9
            self.ifaces = []
            self.caption.set_text("")
            self.hs_page.set_badge_number(0)

    # helper lifecycle ------------------------------------------------------
    def start(self):
        if self.client is not None:
            return
        if self.options.demo:
            self.client = DemoSource(self.on_message)
            return
        if self.options.helper_cmd:
            argv = shlex.split(self.options.helper_cmd)
        elif not os.path.exists(HELPER):
            self.fail("Netwatch is not installed",
                      "The helper is missing from %s.\nRun install.sh from the Netwatch folder: sudo ./install.sh" % HELPER)
            return
        else:
            argv = ["pkexec", HELPER]
        argv += ["--json", "--interval", "1"]
        try:
            self.client = HelperClient(argv, self.on_message, self.on_exit)
        except GLib.Error as e:
            self.fail("Could not start the helper", e.message)
            return
        self._show("waiting")

    def stop(self):
        if self.client is not None:
            self.client.stop()
            self.client = None

    def on_exit(self, status, stderr, last_error):
        self.client = None
        if status == 0:
            self._show("start")
        elif status == 126:                   # pkexec: the password dialog was dismissed
            self._show("start")
        elif status == 127 and not last_error:
            if "authentication agent" in stderr.lower():
                self.fail("No password dialog available",
                          "pkexec found no polkit authentication agent in this session, so it could not ask "
                          "for your password. GNOME and KDE have one; on other desktops start one "
                          "(e.g. polkit-gnome or lxpolkit).\n\n" + stderr)
            else:
                self.fail("Not authorized", stderr or "Monitoring other applications needs an administrator password.")
        else:
            self.fail("Monitoring stopped", last_error or stderr or "The helper exited with status %s." % status)

    def fail(self, title, details):
        self.error_page.set_title(title)
        self.error_details.set_text(details)
        self._show("error")

    # incoming reports ------------------------------------------------------
    def on_message(self, msg):
        kind = msg.get("type")
        if kind == "hello":
            if msg.get("protocol") != PROTOCOL:
                self.stop()
                self.fail("Version mismatch", "The installed helper speaks protocol %s; this window expects %s. "
                          "Run install.sh again." % (msg.get("protocol"), PROTOCOL))
                return
            self.ifaces = msg.get("ifaces", [])
            self._update_title()
            self._show("main")
        elif kind == "tick":
            self.on_tick(msg)
            self.on_hotspot(msg.get("hotspot"))

    def on_tick(self, msg):
        now = time.monotonic()
        dt = max(float(msg.get("dt") or 1.0), 0.05)
        self.last_dt = dt
        self.ifaces = msg.get("ifaces", self.ifaces)
        rx_rate, tx_rate = msg["rx"] / dt, msg["tx"] / dt
        self.total_rx += msg["rx"]
        self.total_tx += msg["tx"]
        self.peak_rx = max(self.peak_rx, rx_rate)
        self.peak_tx = max(self.peak_tx, tx_rate)
        self.hist_rx.append(rx_rate)
        self.hist_tx.append(tx_rate)
        if msg.get("drops"):
            self.last_drop_at = now

        for e in self.apps.values():
            e.rx = e.tx = 0.0
        for e in self.pids.values():
            e.rx = e.tx = 0.0
        metas = msg.get("apps", {})
        for p in msg.get("procs", []):
            key = p["app"]
            meta = metas.get(key, {})
            app = self.apps.get(key)
            if app is None:
                app = self.apps[key] = Entry(key, meta.get("kind", "process"), meta.get("label", key),
                                             meta.get("app_id"), meta.get("desc"))
                self._identify(app)
            app.add(p["rx"], p["tx"], dt, now)
            if p["pid"]:
                # a process is (pid, start time): a recycled pid is somebody else
                ident = (p["pid"], p.get("start", 0))
                info = app.procs.get(ident)
                if info is None:
                    info = app.procs[ident] = {"pid": p["pid"], "comm": p["comm"], "cmd": p["cmd"],
                                               "user": p["user"], "via": p.get("via"), "rx": 0, "tx": 0}
                info["rx"] += p["rx"]
                info["tx"] += p["tx"]
                info["last"] = now
                if p.get("via"):
                    app.via = p["via"]
                pkey = "pid:%d:%d" % ident
                pe = self.pids.get(pkey)
                if pe is None or pe.app_key != key:
                    if pe is not None:
                        self._drop_row(pe)           # never leave a row nobody updates
                    pe = self.pids[pkey] = Entry(pkey, "pid", p["comm"] or app.label, app.app_id, app.desc)
                    pe.app_key, pe.pid, pe.cmd, pe.via = key, p["pid"], p["cmd"], p.get("via")
                    pe.display, pe.icon = p["comm"] or app.display, app.icon
                    pe.procs = {ident: info}
                pe.add(p["rx"], p["tx"], dt, now)
            else:
                pe = self.pids.get(key)          # "other" buckets appear in both views
                if pe is None:
                    pe = self.pids[key] = Entry(key, app.kind, app.label, None, app.desc)
                    pe.display = app.display
                pe.add(p["rx"], p["tx"], dt, now)
        self._forget(now)
        if not self.paused:
            self.refresh()

    def _drop_row(self, e):
        if e.row is not None and e.row.get_parent() is self.list:
            self.list.remove(e.row)

    def _forget(self, now):
        """Keep a long session bounded: anyone on this computer can start
        programs with new names, and every one of them would be a row forever."""
        for pkey in [k for k, e in self.pids.items() if e.pid and now - e.last_active > FORGET_PROCESS_AFTER]:
            self._drop_row(self.pids.pop(pkey))
        for app in self.apps.values():
            if len(app.procs) > MAX_PROCS_PER_APP:
                keep = sorted(app.procs.items(), key=lambda kv: -kv[1]["last"])[:MAX_PROCS_PER_APP]
                app.procs = dict(keep)
        programs = [e for e in self.apps.values() if e.kind != "other"]
        if len(programs) > MAX_APP_ROWS:
            quiet = sorted((e for e in programs if e.idle(now)), key=lambda e: e.rx_total + e.tx_total)
            earlier = self.apps.get("other:earlier")
            if earlier is None:
                earlier = self.apps["other:earlier"] = Entry(
                    "other:earlier", "other", "Earlier programs", None,
                    "Programs that moved a little traffic earlier this session, folded together to keep the list short")
            for e in quiet[:len(programs) - MAX_APP_ROWS + 20]:
                earlier.rx_total += e.rx_total
                earlier.tx_total += e.tx_total
                earlier.last_active = max(earlier.last_active, e.last_active)
                self._drop_row(self.apps.pop(e.key))

    def _identify(self, e):
        """Desktop name and icon for an application entry."""
        program = e.label if e.kind == "process" else None
        name, icon = self.directory.lookup(e.app_id, program)
        if e.kind == "other":
            e.display = e.label
        elif e.kind in ("service", "user-service"):
            e.display = e.label
        else:
            e.display = name or e.label
        e.icon = icon

    # view -------------------------------------------------------------------
    def entries(self):
        return self.apps if self.group == "app" else self.pids

    def refresh(self):
        now = time.monotonic()
        entries = self.entries()
        current = sum(e.rx + e.tx for e in entries.values()) or 1.0
        for e in entries.values():
            if e.row is None:
                e.row = AppRow(self, e)
            if e.row.get_parent() is None:
                self.list.append(e.row)
            e.row.update(self, now, (e.rx + e.tx) / current)
        if not self.hovering:            # re-sorting under the pointer would move the row being clicked
            self.list.invalidate_sort()
        self.list.invalidate_filter()

        bits = self.bits
        self.down.rate.set_text(fmt_rate(self.hist_rx[-1] if self.hist_rx else 0, bits))
        self.up.rate.set_text(fmt_rate(self.hist_tx[-1] if self.hist_tx else 0, bits))
        self.down.detail.set_text("Session %s  ·  peak %s" % (fmt_bytes(self.total_rx), fmt_rate(self.peak_rx, bits)))
        self.up.detail.set_text("Session %s  ·  peak %s" % (fmt_bytes(self.total_tx), fmt_rate(self.peak_tx, bits)))
        self.down.graph.set_values(self.hist_rx)
        self.up.graph.set_values(self.hist_tx)
        self._update_banner(now)
        self._update_title()

    def _update_title(self):
        up = [i["name"] for i in self.ifaces if i.get("uplink")]
        vpn = [i["name"] for i in self.ifaces if i.get("kind") == "vpn"]
        parts = ["Measured on " + (", ".join(up) or "no network")]
        if vpn:
            parts.append("VPN " + ", ".join(vpn))
        if self.paused:
            parts.append("paused")
        self.caption.set_text("  ·  ".join(parts))
        self.title.set_subtitle("paused" if self.paused else "")

    def _update_banner(self, now):
        vpn = [i["name"] for i in self.ifaces if i.get("kind") == "vpn"]
        if now - self.last_drop_at < 10:
            text = "The capture is overloaded and missed some packets — per-app numbers are a little low"
        elif vpn:
            text = ("VPN active (%s): traffic inside the tunnel is shown under each app, and the same "
                    "bytes appear again, encrypted, under the VPN client" % ", ".join(vpn))
        else:
            text = None
        self.banner.set_title(text or "")
        self.banner.set_revealed(text is not None)

    def subtitle(self, e):
        if e.kind == "pid":
            parts = ["pid %d" % e.pid]
            app = self.apps.get(e.app_key)
            if app is not None and app.display != e.display:
                parts.append(app.display)
            if e.cmd:
                parts.append(e.cmd)
            return "  ·  ".join(parts)
        if e.kind == "other":
            return e.desc or ""
        parts = []
        if PROXY_CLIENT.search((e.label or "").lower()) or PROXY_CLIENT.search((e.display or "").lower()):
            parts.append("Proxy/VPN client — apps that use it are counted here")
        elif e.desc:
            parts.append(e.desc)
        if e.kind == "process" and e.via:
            via_name, _ = self.directory.lookup(e.via, None)
            parts.append("started from " + (via_name or e.via))
        now = time.monotonic()
        live = [i for i in e.procs.values() if now - i["last"] < IDLE_AFTER] or list(e.procs.values())
        if len(live) == 1:
            info = live[0]
            parts.append(info["cmd"] if e.kind == "process" else "%s, pid %d" % (info["comm"], info["pid"]))
        elif live:
            parts.append("%d processes" % len(live))
        if not parts:
            parts.append(KIND_NAMES.get(e.kind, ""))
        return "  ·  ".join(parts)

    def _sort(self, a, b):
        ea, eb = a.entry, b.entry
        k = self.sort_key
        if k == "name":
            x, y = ea.display.lower(), eb.display.lower()
            return (x > y) - (x < y)
        if k == "activity":
            va, vb = ea.rx + ea.tx, eb.rx + eb.tx
        else:
            va, vb = getattr(ea, k), getattr(eb, k)
        if va != vb:
            return -1 if va > vb else 1
        ta, tb = ea.rx_total + ea.tx_total, eb.rx_total + eb.tx_total
        if ta != tb:
            return -1 if ta > tb else 1
        return (ea.display.lower() > eb.display.lower()) - (ea.display.lower() < eb.display.lower())

    def _filter(self, row):
        return self.show_idle or not row.entry.idle(time.monotonic())

    def set_sort(self, field):
        self.sort_key = "activity" if self.sort_key == field else field
        for f, (button, title) in self.sort_buttons.items():
            active = f == self.sort_key
            button.set_label(title + (" ▾" if active and f != "name" else " ▴" if active else ""))
            if active:
                button.add_css_class("nw-sorted")
            else:
                button.remove_css_class("nw-sorted")
        self.list.invalidate_sort()

    def reset_totals(self):
        self.total_rx = self.total_tx = 0
        self.peak_rx = self.peak_tx = 0.0
        self.hist_rx.clear()
        self.hist_tx.clear()
        for e in list(self.apps.values()) + list(self.pids.values()):
            e.rx_total = e.tx_total = 0
            for info in e.procs.values():
                info["rx"] = info["tx"] = 0
        self.refresh()

    def show_details(self, e):
        if e.key == "other:hotspot":
            self.views.set_visible_child_name("hotspot")
            return
        app = self.apps.get(e.app_key, e)
        dialog = Adw.Dialog(title=e.display, content_width=620, content_height=560)
        page = Adw.PreferencesPage()
        about = Adw.PreferencesGroup(title="What this is")

        def row(title, subtitle, selectable=False):
            r = Adw.ActionRow(title=title, subtitle=subtitle or "—", use_markup=False,
                              subtitle_selectable=selectable)
            r.add_css_class("property")
            about.add(r)

        row("Kind", KIND_NAMES.get(app.kind) or ("Process" if e.kind == "pid" else "Other"))
        if app.desc:
            row("Description", app.desc)
        if app.app_id:
            row("Application id", app.app_id, True)
        if app.via:
            via_name, _ = self.directory.lookup(app.via, None)
            row("Started from", via_name or app.via)
        row("This session", "↓ %s   ↑ %s" % (fmt_bytes(e.rx_total), fmt_bytes(e.tx_total)))
        page.add(about)

        procs = Adw.PreferencesGroup(title="Processes")
        shown = e.procs if e.kind == "pid" else app.procs
        if not shown:
            procs.set_description("No single process — this row collects traffic Netwatch could not "
                                  "pin on a running program.")
        ranked = sorted(shown.values(), key=lambda info: -(info["rx"] + info["tx"]))
        if len(ranked) > DETAIL_ROWS:
            procs.set_description("The %d busiest of %d processes" % (DETAIL_ROWS, len(ranked)))
        for info in ranked[:DETAIL_ROWS]:
            r = Adw.ActionRow(title="%s  (pid %d, %s)" % (info["comm"], info["pid"], info["user"]),
                              subtitle=info["cmd"], use_markup=False, subtitle_selectable=True,
                              subtitle_lines=3)
            total = Gtk.Label(label="↓ %s\n↑ %s" % (fmt_bytes(info["rx"]), fmt_bytes(info["tx"])), xalign=1)
            total.add_css_class("numeric")
            total.add_css_class("dim-label")
            r.add_suffix(total)
            procs.add(r)
        page.add(procs)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        dialog.set_child(view)
        dialog.present(self)

    # actions ----------------------------------------------------------------
    def _on_group(self, action, value):
        action.set_state(value)
        self.group = value.get_string()
        self.list.remove_all()
        self.refresh()

    def _on_units(self, action, value):
        action.set_state(value)
        self.bits = value.get_string() == "bits"
        self.refresh()
        self.on_hotspot(self.hotspot)

    def _on_show_idle(self, action, value):
        action.set_state(value)
        self.show_idle = value.get_boolean()
        self.list.invalidate_filter()

    def _on_pause(self, action, value):
        action.set_state(value)
        self.paused = value.get_boolean()
        self.pause_button.set_icon_name("media-playback-start-symbolic" if self.paused
                                        else "media-playback-pause-symbolic")
        self._update_title()
        if not self.paused:
            self.refresh()

    def _on_close(self, *_):
        self.stop()
        return False


class App(Adw.Application):
    def __init__(self, options):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE if options.demo
                         else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.options = options
        self.window = None
        for name, accels, handler in (("quit", ["<Control>q"], lambda *_: self.quit()),
                                      ("about", [], lambda *_: self.about())):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", handler)
            self.add_action(act)
            if accels:
                self.set_accels_for_action("app." + name, accels)
        self.set_accels_for_action("win.reset", ["<Control>r"])
        self.set_accels_for_action("win.pause", ["<Control>p"])

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_bytes(GLib.Bytes.new(CSS))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if self.window is None:
            self.window = Window(self, self.options)
            self.window.present()
            self.window.start()          # straight to the password dialog
        else:
            self.window.present()

    def do_shutdown(self):
        if self.window is not None:
            self.window.stop()
        Adw.Application.do_shutdown(self)

    def about(self):
        Adw.AboutDialog(application_name="Netwatch", application_icon=APP_ID, version=VERSION,
                        comments="Which application is using the network, right now.",
                        license_type=Gtk.License.MIT_X11).present(self.window)


def main():
    ap = argparse.ArgumentParser(prog="netwatch", description="Live network usage per application.")
    ap.add_argument("--demo", action="store_true", help="show made-up traffic (no root needed)")
    ap.add_argument("--helper-cmd", help="command that runs the helper instead of pkexec (for development)")
    ap.add_argument("--version", action="version", version="netwatch " + VERSION)
    options, gtk_args = ap.parse_known_args()
    app = App(options)
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError, AttributeError):
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda: (app.quit(), False)[1])
    return app.run([sys.argv[0]] + gtk_args)


if __name__ == "__main__":
    sys.exit(main())
