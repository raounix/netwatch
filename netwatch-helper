# ── output ──────────────────────────────────────────────────────────────────
def human(n, per_second=False):
    unit = "B/s" if per_second else "B"
    for prefix in ("", "k", "M", "G", "T"):
        if abs(n) < 1000 or prefix == "T":
            return ("%d %s%s" if prefix == "" else "%.1f %s%s") % (n, prefix, unit)
        n /= 1000.0


class TextView:
    """`sudo netwatch-top`: a table redrawn every interval, grouped by application."""

    def __init__(self):
        self.totals = {}
        self.meta = {}
        self.names = {}
        self.ifaces = ""

    def __call__(self, msg):
        if msg["type"] == "hello":
            self.ifaces = ", ".join(i["name"] for i in msg["ifaces"])
            return
        dt = msg["dt"] or 1.0
        self.meta.update(msg["apps"])
        now = {}
        for p in msg["procs"]:
            key = p["app"]
            n = now.setdefault(key, [0, 0])
            n[0] += p["rx"]
            n[1] += p["tx"]
            t = self.totals.setdefault(key, [0, 0])
            t[0] += p["rx"]
            t[1] += p["tx"]
            if p["pid"]:
                self.names.setdefault(key, set()).add(p["comm"])
        try:
            cols, rows = os.get_terminal_size()
        except OSError:
            cols, rows = 100, 30
        out = ["\x1b[H\x1b[2J",
               "netwatch  %s   ↓ %s   ↑ %s   (Ctrl-C to quit)" % (
                   self.ifaces, human(msg["rx"] / dt, True), human(msg["tx"] / dt, True)),
               ""]
        if msg["drops"]:
            out.append("  ! %d packets dropped by the capture — the per-app numbers are a little low" % msg["drops"])
        out.append("  %-34s %11s %11s %11s %11s" % ("APPLICATION", "↓ NOW", "↑ NOW", "↓ TOTAL", "↑ TOTAL"))
        order = sorted(self.totals, key=lambda k: (-sum(now.get(k, (0, 0))), -sum(self.totals[k])))
        for key in order[:max(5, rows - 6)]:
            m = self.meta.get(key, {})
            label = m.get("label", key)
            if m.get("kind") == "service":
                label += " (service)"
            n = now.get(key, (0, 0))
            t = self.totals[key]
            out.append("  %-34s %11s %11s %11s %11s" % (
                label[:34], human(n[0] / dt, True), human(n[1] / dt, True), human(t[0]), human(t[1])))
        hs = msg.get("hotspot")
        if hs and (hs["active"] or hs["devices"]):
            ssids = ", ".join("%s (%s)" % (i["ssid"] or "shared", i["name"]) for i in hs["ifaces"]) or "off"
            on = [d for d in hs["devices"] if d["connected"]]
            out += ["", "  HOTSPOT  %s   %d device%s connected" % (ssids, len(on), "" if len(on) == 1 else "s"),
                    "  %-24s %-15s %7s %11s %11s %10s  %s" % ("DEVICE", "IP", "SIGNAL", "↓ NOW", "↑ NOW", "TODAY", "LIMITS")]
            for d in sorted(hs["devices"], key=lambda d: (not d["connected"], -(d["today_up"] + d["today_down"]))):
                name = d["name"] or d["hostname"] or d["vendor"] or d["mac"]
                r = d["rules"]
                limits = ["BLOCKED"] if r["blocked"] else []
                if r["down"]:
                    limits.append("↓" + human(r["down"], True))
                if r["up"]:
                    limits.append("↑" + human(r["up"], True))
                if r["quota"]:
                    limits.append("day %s/%s" % (human(d["quota_used"] or 0), human(r["quota"])))
                out.append("  %-24s %-15s %7s %11s %11s %10s  %s" % (
                    (name if d["connected"] else name + " (away)")[:24], d["ip"] or "—",
                    "%d dBm" % d["signal"] if d["signal"] is not None else "—",
                    human(d["now_down"] / dt, True), human(d["now_up"] / dt, True),
                    human(d["today_up"] + d["today_down"]), " ".join(limits)))
        sys.stdout.write("\n".join(line[:cols] for line in out) + "\n")
        sys.stdout.flush()


def json_out(msg):
    sys.stdout.write(json.dumps(msg, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def fail(message):
    """Report a fatal error the way the caller can read it, then exit 1."""
    if not sys.stdout.isatty():
        try:
            json_out({"type": "error", "message": message})
        except OSError:
            pass
    sys.stderr.write("netwatch-helper: %s\n" % message)
    return 1


IFNAME = re.compile(r"[A-Za-z0-9_.:@-]{1,15}")


def main(argv):
    ap = argparse.ArgumentParser(
        prog="netwatch-helper",
        description="Live network usage per application (needs root).")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--json", action="store_true", help="one JSON report per line (for the window)")
    mode.add_argument("--text", action="store_true", help="a table redrawn in the terminal")
    ap.add_argument("--interval", type=float, default=1.0, help="seconds between reports (0.25–10)")
    ap.add_argument("--interfaces", help="comma-separated interfaces to capture instead of the uplinks")
    ap.add_argument("--no-hotspot", action="store_true", help="leave the hotspot (devices, limits) alone")
    service = ap.add_mutually_exclusive_group()
    service.add_argument("--restore", action="store_true", help=argparse.SUPPRESS)      # systemd, at boot
    service.add_argument("--save-usage", action="store_true", help=argparse.SUPPRESS)   # systemd, at shutdown
    service.add_argument("--new-day", action="store_true", help=argparse.SUPPRESS)      # systemd timer, midnight
    ap.add_argument("--version", action="version", version="netwatch-helper " + VERSION)
    args = ap.parse_args(argv)
    action = "restore" if args.restore else "save-usage" if args.save_usage else "new-day" if args.new_day else None
    if action:
        if os.geteuid() != 0:
            return fail("needs root")
        return run_service(action)

    if not 0.25 <= args.interval <= 10:
        ap.error("--interval must be between 0.25 and 10")
    forced = None
    if args.interfaces:
        forced = [n for n in args.interfaces.split(",") if n]
        if not forced or not all(IFNAME.fullmatch(n) for n in forced):
            ap.error("--interfaces takes interface names like enp3s0,wlan0")
    if os.geteuid() != 0:
        return fail("needs root — run it with sudo (the Netwatch window asks through pkexec)")

    text = args.text or (not args.json and sys.stdout.isatty())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        Monitor(args.interval, forced, TextView() if text else json_out, hotspot=not args.no_hotspot).run()
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    finally:
        if text:
            sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
