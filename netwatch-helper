# ── packet capture ──────────────────────────────────────────────────────────
SOL_PACKET = 263
PACKET_RX_RING = 5
PACKET_STATISTICS = 6
PACKET_VERSION = 10
TPACKET_V2 = 1
TP_STATUS_USER = 1
PACKET_OTHERHOST = 3             # someone else's packet, seen only in promiscuous mode
PACKET_OUTGOING = 4
ETH_P_ALL = 0x0003

FRAME_SIZE = 512                 # one slot per packet: 66 bytes of ring header + ~446 of packet
BLOCK_SIZE = 1 << 16
BLOCK_NR = 128                   # 8 MiB per interface = 16384 packets of headroom
FRAMES = BLOCK_SIZE // FRAME_SIZE * BLOCK_NR
FRAME_HDR = struct.Struct("<IIIHH")   # tpacket2_hdr: status, len, snaplen, mac, net
SLL_PKTTYPE = 32 + 10            # sockaddr_ll sits right after the 32-byte tpacket2_hdr
RELEASE = bytes(4)               # TP_STATUS_KERNEL: hand the slot back

UNATTRIBUTED = 0                 # pseudo-pids for traffic no process owns
OTHER_PROTOCOLS = -1
HOTSPOT_DEVICES = -2
MAX_PENDING = 50_000             # unresolved flows kept per interval (a port scan must not eat memory)

# A brand-new connection is missing from a table read a moment earlier, so the
# owner of an unknown flow is looked up right after the batch of packets it
# arrived in — a `curl` or a `git fetch` can start, download and exit in well
# under a second, and once it is gone nobody can say whose bytes those were.
# Every new flow of a batch shares one read of the kernel tables, and a token
# bucket caps the work: at most RESOLVE_SHARE of one core over time, in bursts
# of up to RESOLVE_BURST seconds after a quiet spell.
RESOLVE_SHARE = 0.15
RESOLVE_BURST = 0.05
RETRY = 0.02                     # a flow that could not be placed is tried again after this
RETRY_SOON = 0.002               # …or this, when its socket exists but no process lists it yet:
                                 # accept() shows the new socket in /proc/net/tcp a moment
                                 # before the fd lands in the process's fd table
OWNERS_FULL_EVERY = 30.0         # full rebuild, so sockets that closed long ago are forgotten
HOT_PIDS = 64                    # recently active processes, searched first for a new socket


class Ring:
    """One TPACKET_V2 receive ring bound to one interface."""

    def __init__(self, ifname):
        self.ifname = ifname
        self.head = 0
        # Protocol 0 keeps the socket deaf until bind(), so no packet from some
        # other interface can land in the ring while it is being set up.
        sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, 0)
        self.mm = None
        try:
            sock.setsockopt(SOL_PACKET, PACKET_VERSION, TPACKET_V2)
            sock.setsockopt(SOL_PACKET, PACKET_RX_RING,
                            struct.pack("4I", BLOCK_SIZE, BLOCK_NR, FRAME_SIZE, FRAMES))
            self.mm = mmap.mmap(sock.fileno(), BLOCK_SIZE * BLOCK_NR,
                                mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
            sock.bind((ifname, ETH_P_ALL))
        except BaseException:
            if self.mm is not None:
                self.mm.close()
            sock.close()
            raise
        self.sock = sock

    def fileno(self):
        return self.sock.fileno()

    def drops(self):
        """Packets the kernel had to drop since the last call (reading resets it)."""
        try:
            _, dropped = struct.unpack("II", self.sock.getsockopt(SOL_PACKET, PACKET_STATISTICS, 8))
            return dropped
        except OSError:
            return 0

    def close(self):
        try:
            self.mm.close()
        except (BufferError, ValueError):
            pass
        self.sock.close()


# ── interfaces ──────────────────────────────────────────────────────────────
def _read(path, limit=4096):
    try:
        with open(path, "rb") as f:
            return f.read(limit)
    except OSError:
        return b""


def iface_kind(name):
    """What an interface is, from sysfs. Decides whether its packets are counted:
    container bridges and their veth ports carry traffic the uplink already
    carries (after NAT), and loopback is not network traffic at all."""
    d = "/sys/class/net/" + name
    if name == "lo" or _read(d + "/type").strip() == b"772":
        return "loopback"
    devtype = ""
    for line in _read(d + "/uevent").splitlines():
        if line.startswith(b"DEVTYPE="):
            devtype = line[8:].decode("ascii", "replace")
    if devtype == "bridge" or os.path.isdir(d + "/bridge"):
        return "bridge"
    if os.path.exists(d + "/brport"):
        return "bridge-port"
    if devtype in ("vlan", "macvlan", "ipvlan", "macvtap"):
        return "stacked"         # rides on a physical interface that is captured anyway
    if os.path.exists(d + "/device"):
        return "physical"        # ethernet, wifi, USB tethering, a VM's virtio NIC
    if devtype == "wireguard" or os.path.exists(d + "/tun_flags") \
            or _read(d + "/type").strip() in (b"65534", b"512"):
        return "vpn"             # tun/tap, wireguard, ppp
    return "virtual"


def default_route_ifaces():
    """Interfaces that carry a default route (IPv4 or IPv6): the way out."""
    out = set()
    for line in _read("/proc/net/route", 1 << 20).splitlines()[1:]:
        f = line.split()
        if len(f) >= 8 and f[1] == b"00000000" and f[7] == b"00000000":
            out.add(f[0].decode("ascii", "replace"))
    for line in _read("/proc/net/ipv6_route", 4 << 20).splitlines():
        f = line.split()
        if len(f) >= 10 and f[0] == b"0" * 32 and f[1] == b"00":
            out.add(f[9].decode("ascii", "replace"))
    out.discard("lo")
    return out


def read_dev_counters():
    """Kernel byte counters per interface (exact, unlike a packet capture)."""
    out = {}
    for line in _read("/proc/net/dev", 1 << 20).splitlines()[2:]:
        name, _, rest = line.partition(b":")
        f = rest.split()
        if len(f) >= 9:
            out[name.strip().decode("ascii", "replace")] = (int(f[0]), int(f[8]))
    return out


# ── kernel socket tables ────────────────────────────────────────────────────
ANY4 = bytes(4)
ANY6 = bytes(16)
V4MAPPED = bytes(10) + b"\xff\xff"
LITTLE = sys.byteorder == "little"


def _addr(field, cache):
    """'0100007F:1F90' → (b'\\x7f\\x00\\x00\\x01', 8080). The kernel prints each
    32-bit word of the address in host byte order. IPv4-mapped IPv6 addresses
    become plain IPv4, so a dual-stack socket matches IPv4 packets."""
    hexip, _, hexport = field.partition(b":")
    ip = cache.get(hexip)
    if ip is None:
        raw = binascii.unhexlify(hexip)
        if LITTLE:
            raw = b"".join(raw[i:i + 4][::-1] for i in range(0, len(raw), 4))
        if len(raw) == 16 and raw[:12] == V4MAPPED:
            raw = raw[12:]
        ip = cache[hexip] = raw
    return ip, int(hexport, 16)


TCP4, TCP6, UDP4, UDP6 = "/proc/net/tcp", "/proc/net/tcp6", "/proc/net/udp", "/proc/net/udp6"


class SocketTable:
    """(protocol, local, remote) → socket inode, from /proc/net/{tcp,udp}{,6}.

    Each file is kept on its own so a lookup re-reads only what it needs: an
    IPv6 flow only tcp6/udp6, an IPv4 flow the IPv4 file plus the IPv6 one
    (dual-stack sockets carry IPv4 traffic as ::ffff:a.b.c.d)."""

    def __init__(self):
        self.conn = {path: {} for path in (TCP4, TCP6, UDP4, UDP6)}   # (lip, lport, rip, rport) → inode
        self.bound = {path: {} for path in (TCP4, TCP6, UDP4, UDP6)}  # (lip, lport) → inode: TCP listeners, UDP sockets
        self._ipcache = {}

    @staticmethod
    def files(flow):
        if flow[0] == 6:
            return (TCP4, TCP6) if len(flow[1]) == 4 else (TCP6,)
        return (UDP4, UDP6) if len(flow[1]) == 4 else (UDP6,)

    def refresh(self, paths=(TCP4, TCP6, UDP4, UDP6)):
        cache = self._ipcache
        if len(cache) > 20_000:
            cache.clear()
        for path in paths:
            tcp = path in (TCP4, TCP6)
            conn, bound = {}, {}
            for line in _read(path, 64 << 20).splitlines()[1:]:
                f = line.split()
                if len(f) < 10:
                    continue
                inode = int(f[9])
                if not inode:
                    continue     # TIME_WAIT and friends: no process holds them any more
                lip, lport = _addr(f[1], cache)
                rip, rport = _addr(f[2], cache)
                if tcp:
                    if f[3] == b"0A":
                        bound[(lip, lport)] = inode
                    else:
                        conn[(lip, lport, rip, rport)] = inode
                else:
                    bound.setdefault((lip, lport), inode)
                    if rport:
                        conn[(lip, lport, rip, rport)] = inode
            self.conn[path], self.bound[path] = conn, bound

    def _bound(self, paths, lip, lport):
        for path in paths:
            t = self.bound[path]
            inode = t.get((lip, lport)) or (t.get((ANY4, lport)) if len(lip) == 4 else 0) \
                or t.get((ANY6, lport))
            if inode:
                return inode
        return 0

    def listener(self, flow):
        """The listening socket an incoming TCP connection was accepted from."""
        return self._bound(self.files(flow), flow[1], flow[2]) if flow[0] == 6 else 0

    def lookup(self, flow):
        _, lip, lport, rip, rport = flow
        paths = self.files(flow)
        for path in paths:
            inode = self.conn[path].get((lip, lport, rip, rport))
            if inode:
                return inode
        return self._bound(paths, lip, lport)


def scan_owners(owners, wanted=None, first=()):
    """Fill socket inode → pid from the socket:[inode] links in /proc/<pid>/fd.
    With `wanted`, stop as soon as all of those are found, looking first at
    `first` (processes that were just moving data — a browser opening one more
    connection) and then at the newest pids (a command that just started)."""
    try:
        pids = sorted((int(n) for n in os.listdir("/proc") if n.isdigit()), reverse=True)
    except OSError:
        return
    missing = set(wanted) if wanted else None
    if missing is not None and first:
        head = [pid for pid in first if pid > 0]
        seen = set(head)
        pids = head + [pid for pid in pids if pid not in seen]
    for pid in pids:
        d = "/proc/%d/fd/" % pid
        try:
            fds = os.listdir(d)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(d + fd)
            except OSError:
                continue
            if target.startswith("socket:["):
                inode = int(target[8:-1])
                prev = owners.get(inode)
                # Forked children share sockets: keep the parent. But not pid 1 —
                # with socket activation systemd holds the listener too, and the
                # traffic is the service's, not systemd's.
                if prev is None or prev == 1 or (pid < prev and pid != 1):
                    owners[inode] = pid
                if missing is not None:
                    missing.discard(inode)
        if missing is not None and not missing:
            return


